# Docker Postgres Container Credentials
# If you want you can cange it your prefered postgres db provider credentials
POSTGRES_URL=jdbc:postgresql://localhost:5432/postgres
POSTGRES_USER=instello
POSTGRES_PASSWORD=instello@5432

# Bootstrap Platform Admin
BOOTSTRAP_ADMIN_EMAIL=admin@instello.in

# Redis (Spring Session + admin sign-in codes)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit in compose.yml receives mail on 1025. UI: http://localhost:8025
MAIL_HOST=127.0.0.1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_FROM=noreply@instello.local