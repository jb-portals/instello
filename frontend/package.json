{
  "name": "instello-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run build",
    "ui:add": "cd apps/admin && bunx shadcn@latest add"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@instello/typescript-config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
