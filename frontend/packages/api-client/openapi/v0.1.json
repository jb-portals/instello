{
  "openapi": "3.1.0",
  "info": {
    "description": "Instello ERP backend API.\n\nAuthenticated endpoints use the session cookie set by the admin OTP login. State-changing requests also need the CSRF token from GET /auth/csrf-token in the X-CSRF-TOKEN header.",
    "title": "Instello API",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "description": "Platform admin authentication operations",
      "name": "auth/admin"
    },
    {
      "description": "Users operations",
      "name": "users"
    },
    {
      "description": "Authentication operations for common users",
      "name": "auth"
    },
    {
      "description": "Accept an owner invitation and create an account",
      "name": "auth/invitations"
    },
    {
      "description": "Verify an account email with a one-time code",
      "name": "auth/email-verification"
    }
  ],
  "paths": {
