  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          },
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password",
          "token"
        ]
      },
      "AcceptInvitationResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "AccessRequestDetail": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressResponse"
          },
          "adminNotes": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invitation": {
            "$ref": "#/components/schemas/InvitationInfo"
          },
          "lastName": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/OrganizationInfo"
          },
          "organizationName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "rejectionReason": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedBy": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONTACTED",
              "APPROVED",
              "REJECTED"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccessRequestSummary": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lastName": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONTACTED",
              "APPROVED",
              "REJECTED"
            ]
          }
        }
      },
      "AddressRequest": {
        "type": "object",
        "properties": {
          "addressLine": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "country": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "state": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "addressLine",
          "city",
          "state"
        ]
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "addressLine": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "AdminLoginResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AdminOtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "AdminVerifyOtpRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{6}"
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "email"
        ]
      },
      "ApproveAccessRequestRequest": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressRequest"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "minLength": 0
          },
          "organizationName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9 ()-]{7,20}$"
          }
        }
      },
      "CreateAccessRequestRequest": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressRequest"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "minLength": 0
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "organizationName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\+?[0-9 ()-]{7,20}$"
          }
        },
        "required": [
          "address",
          "email",
          "firstName",
          "lastName",
          "organizationName",
          "phone"
        ]
      },
      "CreateAccessRequestResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONTACTED",
              "APPROVED",
              "REJECTED"
            ]
          }
        }
      },
      "CsrfToken": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "CsrfTokenResponse": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "authorities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ROLE_ADMIN",
                "ROLE_OWNER",
                "ROLE_USER"
              ]
            }
          },
          "email": {
            "type": "string"
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      },
      "EmailOtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "InvitationInfo": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REVOKED",
              "EXPIRED"
            ]
          }
        }
      },
      "InvitationPreviewResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "organizationName": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OrganizationInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PageResponseAccessRequestSummary": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccessRequestSummary"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Pageable": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "RejectAccessRequestRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "reason"
        ]
      },
      "UpdateAccessRequestRequest": {
        "type": "object",
        "properties": {
          "adminNotes": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONTACTED",
              "APPROVED",
              "REJECTED"
            ]
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{6}"
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "email"
        ]
      }
    }
  }
}
